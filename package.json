{
  "name": "eloria",
  "private": true,
  "version": "0.3.0",
  "description": "Eloria: your knowledge, beautifully connected. A personal workspace for research, writing and knowledge.",
  "author": "Amédée Wend-Bénédo DERA",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "app": "tauri dev",
    "bundle": "node scripts/bundle.mjs",
    "release": "node scripts/release.mjs",
    "test:core": "cargo test -p eloria-core",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:commands": "node scripts/check-commands.mjs",
    "app:safe": "node scripts/check-commands.mjs && cargo build -p eloria && tauri dev"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
