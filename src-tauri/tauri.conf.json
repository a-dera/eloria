{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eloria",
  "version": "0.3.0",
  "identifier": "com.adera.eloria",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Eloria",
        "width": 1440,
        "height": 920,
        "minWidth": 820,
        "minHeight": 520,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your knowledge, beautifully connected.",
    "longDescription": "A personal workspace for research, writing and knowledge.",
    "publisher": "Amédée Wend-Bénédo DERA",
    "copyright": "© 2026 Amédée Wend-Bénédo DERA",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": true,
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": [
          "fr-FR",
          "en-US"
        ]
      }
    },
    "licenseFile": "../LICENSE"
  }
}
